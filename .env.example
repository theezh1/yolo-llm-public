# ── Telegram ────────────────────────────────────────────────────────────
BOT_TOKEN=
# 0 = serve ALL chats (testing). Set to your group id to lock the bot down.
ALLOWED_CHAT_ID=0

# ── Vision backend: groq | local ───────────────────────────────────────
VISION_BACKEND=groq

# ── Groq (VISION_BACKEND=groq) ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=llama-3.1-8b-instant

# ── Local FastVLM (VISION_BACKEND=local) ───────────────────────────────
LOCAL_VISION_URL=http://localhost:8100/v1/chat/completions
LOCAL_VISION_MODEL=vikhyatk/moondream2
# HF_TOKEN=   # only if the model is gated on HuggingFace

# ── YOLO ────────────────────────────────────────────────────────────────
YOLO_MODEL=yolo11n.pt
